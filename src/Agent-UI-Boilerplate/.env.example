# Base API URL (overrides the default profile URL when set)
VITE_API_BASE_URL=http://localhost:3002/api/v1

# Active Backend Profile: atlas-v3 | prompt-lab | info-assistant | dev-assist | custom
VITE_DEFAULT_BACKEND_PROFILE=atlas-v3

# Request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Automatically fall back to realistic streaming agent simulation when backend is offline
VITE_ENABLE_MOCK_FALLBACK=true
